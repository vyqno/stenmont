{
  "name": "@stenmont/react",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm --clean --target es2023 --external react && tsc -p tsconfig.build.json && node ../../scripts/fix-dts-imports.mjs dist"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "description": "React pay button for Stenmont checkout.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenmont/stenmont.git",
    "directory": "packages/react"
  },
  "homepage": "https://stenmont.com",
  "keywords": [
    "stablecoin",
    "payments",
    "usdt",
    "whitechain",
    "invoices"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
