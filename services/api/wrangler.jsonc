{
  // Top level = local development only. Never deploy it. Use --env staging, then (only when approved) --env production.
  // Secrets (keys, client secrets) are NOT here: they live in Cloudflare via `wrangler secret`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stenmont-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "ENVIRONMENT": "local",
    "WHITECHAIN_RPC": "https://rpc.testnet.whitechain.io",
    "WHITECHAIN_CHAIN_ID": "1874",
    "USDT_ADDRESS": "0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7",
    "SEPOLIA_RPC": "https://sepolia.gateway.tenderly.co",
    "ENS_ROOT_NAME": "stenmont.eth",
    "ENS_SUBNAME_REGISTRY": "0xE100C72C3BD9781a7AE4d653E0518b54888A5f0c",
    "ROUTER_ADDRESS": "0x4c32942616d2BBeDD34bA1178bBF5823FDbbdDC0",
    "ROUTER_DEPLOY_BLOCK": "12342562",
    "FACTORY_ADDRESS": "0x5101c37647581c81b462436af2D7ac8ccD08D33A",
    "SUBSCRIPTION_MANAGER_ADDRESS": "0x0e22748d63717D51eE8DFa5A62413A11dda981cF",
    "INVESTOR_REGISTRY_ADDRESS": "0x6B8490a893C860888f65ce410b0b287CA1c9B8fa",
    "INVOICE_CLAIM_ADDRESS": "0x2EB9aaF14A2d729BC3F185A144571fCd23454914",
    "REPUTATION_REGISTRY_ADDRESS": "0x751165C1E587637aF6EC0ff91b87Fa7Bd08a9ed5",
    "INDEXER_CONFIRMATIONS": "2",
    "APP_URL": "http://localhost:3000",
    "API_URL": "http://localhost:8787"
  },
  "durable_objects": { "bindings": [{ "name": "RELAYER", "class_name": "Relayer" }, { "name": "ENS_SENDER", "class_name": "EnsSender" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relayer"] }, { "tag": "v2", "new_sqlite_classes": ["EnsSender"] }],
  "queues": {
    "producers": [{ "binding": "WEBHOOKS", "queue": "stenmont-webhooks-local" }],
    "consumers": [{ "queue": "stenmont-webhooks-local", "max_retries": 100 }]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "stenmont-db-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "env": {
    "staging": {
      "name": "stenmont-api-staging",
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["notifications@stenmont.com"] }],
      "workers_dev": false,
      "routes": [{ "pattern": "api-staging.stenmont.com", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "staging",
        "INVOICE_CREATION_PAUSED": "yes",
        "INVOICE_DEFAULT_VERSION": "2",
        "INVOICE_ACCEPTANCE_MERCHANT_ID": "m_6e8e647cb8f588bd",
        "INVOICE_ACCEPTANCE_MERCHANT_IDS": "m_6e8e647cb8f588bd,m_59b0e58672a6ba81",
        "GEMINI_BACKEND": "vertex_express",
        "ROUTER_V2_ADDRESS": "0xda4dfa02b95fd14bfac657535cbcac7f339bd8e6",
        "ROUTER_V2_DEPLOY_BLOCK": "12391120",
        "INVOICE_CLAIM_V2_ADDRESS": "0xd994a18962dda95aa23ba2d25ba9cc7c8addaf3d",
        "INVOICE_CLAIM_V2_DEPLOY_BLOCK": "12391125",
        "INVESTOR_REGISTRY_V2_ADDRESS": "0x03b5803bb1b65401f8e7130a044e46b00aa0abd6",
        "REPUTATION_REGISTRY_V2_ADDRESS": "0xffee131f70576cd8bd7742f1a9e93276d1821e05",
        "INVOICE_ACK_ADDRESS": "0xfeccfc30714bb3972a5cffe02371f475570aa011",
        "EMAIL_MODE": "sink",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "WHITECHAIN_RPC": "https://rpc.testnet.whitechain.io",
        "WHITECHAIN_CHAIN_ID": "1874",
        "USDT_ADDRESS": "0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7",
        "SEPOLIA_RPC": "https://sepolia.gateway.tenderly.co",
        "ENS_ROOT_NAME": "stenmont.eth",
        "ENS_SUBNAME_REGISTRY": "0xE100C72C3BD9781a7AE4d653E0518b54888A5f0c",
        "ROUTER_ADDRESS": "0x4c32942616d2BBeDD34bA1178bBF5823FDbbdDC0",
        "ROUTER_DEPLOY_BLOCK": "12342562",
        "FACTORY_ADDRESS": "0x5101c37647581c81b462436af2D7ac8ccD08D33A",
        "SUBSCRIPTION_MANAGER_ADDRESS": "0x0e22748d63717D51eE8DFa5A62413A11dda981cF",
        "INVESTOR_REGISTRY_ADDRESS": "0x6B8490a893C860888f65ce410b0b287CA1c9B8fa",
        "INVOICE_CLAIM_ADDRESS": "0x2EB9aaF14A2d729BC3F185A144571fCd23454914",
        "REPUTATION_REGISTRY_ADDRESS": "0x751165C1E587637aF6EC0ff91b87Fa7Bd08a9ed5",
        "INDEXER_CONFIRMATIONS": "2",
        "FAUCET_IP_LIMIT": "40",
        "REFUND_APPROVAL_THRESHOLD": "2000000",
        "ACTIVATE_IP_LIMIT": "30",
        "APP_URL": "https://app-staging.stenmont.com",
        "API_URL": "https://api-staging.stenmont.com"
      },
      "durable_objects": { "bindings": [{ "name": "RELAYER", "class_name": "Relayer" }, { "name": "ENS_SENDER", "class_name": "EnsSender" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relayer"] }, { "tag": "v2", "new_sqlite_classes": ["EnsSender"] }],
      "triggers": { "crons": ["* * * * *"] },
      "queues": {
        "producers": [{ "binding": "WEBHOOKS", "queue": "stenmont-webhooks-staging" }],
        "consumers": [{ "queue": "stenmont-webhooks-staging", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 100 }]
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "stenmont-db-staging", "database_id": "4d58ae4e-a8af-440a-a03b-092d696d7cd7", "migrations_dir": "migrations" }
      ]
    },
    "production": {
      "name": "stenmont-api",
      "workers_dev": false,
      "routes": [{ "pattern": "api.stenmont.com", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "WHITECHAIN_RPC": "https://rpc.testnet.whitechain.io",
        "WHITECHAIN_CHAIN_ID": "1874",
        "USDT_ADDRESS": "0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7",
        "SEPOLIA_RPC": "https://sepolia.gateway.tenderly.co",
        "ENS_ROOT_NAME": "stenmont.eth",
        "ENS_SUBNAME_REGISTRY": "0x0000000000000000000000000000000000000000",
        "ROUTER_ADDRESS": "0x0000000000000000000000000000000000000000",
        "ROUTER_DEPLOY_BLOCK": "0",
        "FACTORY_ADDRESS": "0x0000000000000000000000000000000000000000",
        "SUBSCRIPTION_MANAGER_ADDRESS": "0x0000000000000000000000000000000000000000",
        "INVESTOR_REGISTRY_ADDRESS": "0x0000000000000000000000000000000000000000",
        "INVOICE_CLAIM_ADDRESS": "0x0000000000000000000000000000000000000000",
        "REPUTATION_REGISTRY_ADDRESS": "0x0000000000000000000000000000000000000000",
        "INDEXER_CONFIRMATIONS": "2",
        "APP_URL": "https://app.stenmont.com",
        "API_URL": "https://api.stenmont.com"
      },
      // No cron trigger until the production router is deployed (ROUTER_ADDRESS above is a placeholder).
      "durable_objects": { "bindings": [{ "name": "RELAYER", "class_name": "Relayer" }, { "name": "ENS_SENDER", "class_name": "EnsSender" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relayer"] }, { "tag": "v2", "new_sqlite_classes": ["EnsSender"] }],
      "triggers": { "crons": [] },
      "queues": {
        "producers": [{ "binding": "WEBHOOKS", "queue": "stenmont-webhooks" }],
        "consumers": [{ "queue": "stenmont-webhooks", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 100 }]
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "stenmont-db", "database_id": "8a6bbf8d-ad79-4db9-9fc4-7fa598a89a1e", "migrations_dir": "migrations" }
      ]
    }
  }
}
