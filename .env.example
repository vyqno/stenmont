# REFERENCE ONLY. No values here. Real secrets live in Cloudflare, per environment.
# .env (gitignored) is only my local paste area; I paste a token there once and it is pushed
# to Cloudflare with `wrangler secret bulk`. Never commit .env. Never put keys in code or wrangler.jsonc.
#
# Legend:  [secret]  = Cloudflare Worker secret (staging and production, set with `wrangler secret`)
#          [var]     = plain setting in wrangler.jsonc "vars" (public, not secret)
#          [local]   = used only on this machine (deploying contracts, demo scripts); never uploaded

# --- Wallets (testnet). In Cloudflare the relayer and attester keys are named RELAYER_PRIVATE_KEY and ATTESTER_PRIVATE_KEY.
STENMONT_DEPLOYER_ADDRESS=          # [local]
STENMONT_DEPLOYER_PRIVATE_KEY=      # [local] deploys contracts
STENMONT_RELAYER_ADDRESS=           # [var]
STENMONT_RELAYER_PRIVATE_KEY=       # [secret] as RELAYER_PRIVATE_KEY (pays gas)
STENMONT_ATTESTER_ADDRESS=          # [var]
STENMONT_ATTESTER_PRIVATE_KEY=      # [secret] as ATTESTER_PRIVATE_KEY (signs World/ENS attestations)
STENMONT_DEMO_PAYER_ADDRESS=        # [local]
STENMONT_DEMO_PAYER_PRIVATE_KEY=    # [local] demo scripts only

# --- Cloudflare
CLOUDFLARE_ACCOUNT_ID=              # [local]
CLOUDFLARE_API_TOKEN=               # [local] CI deploys only

# --- Chains
WHITECHAIN_RPC=                     # [var]
WHITECHAIN_CHAIN_ID=                # [var]
WHITECHAIN_EXPLORER=                # [var]
USDT_ADDRESS=                       # [var]
SEPOLIA_RPC=                        # [var]
ENS_ROOT_NAME=                      # [var]
STENMONT_ENS_REGISTRAR_ADDRESS=     # [var]  wallet that issues subnames under stenmont.eth (Sepolia)
STENMONT_ENS_REGISTRAR_PRIVATE_KEY= # [secret: ENS_REGISTRAR_PRIVATE_KEY]

# --- Verification (sandbox KYC provider; off in production and without this)
KYC_MOCK_WEBHOOK_SECRET=            # [secret] signs the sandbox KYC provider's webhooks. Test environments only.

# --- World
WORLD_OIDC_CLIENT_ID=               # [secret] Agent Pass client
WORLD_OIDC_CLIENT_SECRET=           # [secret]
WORLD_OIDC_ISSUER=                  # [var]
WORLD_APP_ID=                       # [secret] IDKit app
WORLD_RP_ID=                        # [secret]
WORLD_RP_SIGNING_KEY=               # [secret] PRIVATE key (0x + 64 hex), shown once by World. Not the address.
WORLD_DEVELOPER_API_KEY=            # [local] Developer Portal MCP only

# --- App
APP_URL=                            # [var] differs per environment
API_URL=                            # [var] differs per environment
SESSION_SECRET=                     # [secret] different value in staging and production
WEBHOOK_TEST_URL=                   # [local] Phase 2 test only
STENMONT_FACILITATOR_ADDRESS=        # [var]  wallet that sends x402 settlements (needs WBT for gas)
STENMONT_FACILITATOR_PRIVATE_KEY=    # [secret: FACILITATOR_PRIVATE_KEY]
