{
  "name": "@stenmont/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "build:cf": "opennextjs-cloudflare build",
    "typecheck": "next typegen && tsc --noEmit",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "deploy:production": "test \"$STENMONT_CONFIRM_PRODUCTION\" = yes || (echo 'Refusing: set STENMONT_CONFIRM_PRODUCTION=yes after staging is verified and approved' && exit 1); opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "llms": "node scripts/build-llms.mts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "@opennextjs/cloudflare": "^1.20.16",
    "@stenmont/shared": "workspace:*",
    "@worldcoin/idkit": "^4.6.0",
    "lenis": "^1.3.27",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@stenmont/sdk": "workspace:*",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "packageManager": "pnpm@12.16.1"
}
